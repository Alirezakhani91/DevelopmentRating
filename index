<!DOCTYPE html>
<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Daily Market — Regional Championship</title>
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@fontsource-variable/vazirmatn@5.3.0/index.css">
<style>
:root{
  --bg:#070a0f;
  --panel:#0e141d;
  --panel2:#121a25;
  --line:#202c3d;
  --text:#f8fafc;
  --muted:#8b9bb0;
  --green:#00d084;
  --blue:#4f8ef7;
  --amber:#ffb020;
  --red:#ff4d67;
  --silver:#b8c2cf;
  --bronze:#b87333;
  --font:'Vazirmatn Variable','Vazirmatn','Vazir',Tahoma,Arial,sans-serif;
}
*{box-sizing:border-box;margin:0;padding:0;font-family:var(--font)!important}
html,body{background:
  radial-gradient(1100px 520px at 100% -10%,rgba(0,208,132,.06),transparent 60%),
  radial-gradient(900px 520px at 0 100%,rgba(79,142,247,.08),transparent 60%),
  var(--bg);
  color:var(--text);min-height:100%;
}
body{overflow-x:hidden}
button,input,select{font:inherit}

.app{
  width:min(1880px,100%);
  margin:0 auto;
  padding:16px 18px 30px;
}

.header{
  position:sticky;top:0;z-index:30;
  display:flex;align-items:center;justify-content:space-between;gap:14px;
  padding:14px 16px;margin-bottom:12px;
  border:1px solid rgba(255,255,255,.055);border-radius:18px;
  background:rgba(8,12,18,.93);backdrop-filter:blur(14px);
  box-shadow:0 16px 50px rgba(0,0,0,.25)
}
.brand{display:flex;align-items:center;gap:12px;min-width:0}
.logo{
  width:48px;height:48px;border-radius:14px;display:grid;place-items:center;font-size:23px;
  background:linear-gradient(135deg,#0ca678,#2563eb 68%,#7c3aed);
  box-shadow:0 10px 28px rgba(37,99,235,.20)
}
.brandTitle{font-size:25px;font-weight:950;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.brandSub{font-size:12px;color:#8292a8;margin-top:3px}
.actions{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.badge,.btn{
  border:1px solid #24334a;background:#111a27;color:#d3dce8;border-radius:10px;
  padding:9px 12px;font-size:12px
}
.live{color:#38e8a0;border-color:rgba(0,208,132,.24);background:rgba(0,208,132,.07)}
.btn{cursor:pointer;font-weight:900}
.btn:hover{border-color:#4f8ef7;color:#9fc0ff}

.hero{
  display:grid;grid-template-columns:1.2fr repeat(4,1fr);gap:10px;
  margin-bottom:12px
}
.heroMain,.heroKpi{
  position:relative;overflow:hidden;
  min-height:116px;
  border:1px solid rgba(255,255,255,.055);border-radius:17px;
  background:linear-gradient(145deg,#0d141e,#0a0f17);
  padding:15px 16px
}
.heroMain{
  background:
    radial-gradient(520px 180px at 100% -20%,rgba(0,208,132,.10),transparent 60%),
    linear-gradient(145deg,#0d141e,#0a0f17)
}
.heroMain:before{content:"";position:absolute;right:0;top:0;bottom:0;width:4px;background:linear-gradient(var(--green),var(--blue))}
.heroKpi:before{content:"";position:absolute;right:0;top:0;width:100%;height:3px;background:var(--c)}
.eyebrow{font-size:11px;color:#34d399;font-weight:900;letter-spacing:.08em}
.heroTitle{font-size:22px;font-weight:950;margin-top:5px}
.heroText{font-size:11px;color:#78899f;line-height:1.7;margin-top:4px}
.kLabel{font-size:11px;color:#7f90a6}
.kVal{font-size:36px;font-weight:950;margin-top:8px;line-height:1}
.kSub{font-size:10px;color:#63748a;margin-top:6px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}

.controls{
  display:grid;grid-template-columns:minmax(230px,1.3fr) repeat(3,minmax(150px,.7fr)) auto auto;
  gap:8px;margin-bottom:12px;padding:9px;
  background:#0b1119;border:1px solid #1b2738;border-radius:13px
}
.controls input,.controls select,.controls button{
  width:100%;border:1px solid #223149;background:#111a27;color:#e2e8f0;
  border-radius:9px;padding:11px 12px;font-size:12px;outline:none
}
.controls button{cursor:pointer;font-weight:900}
.count{display:flex;align-items:center;justify-content:center;color:#93a4b8}


.executiveArena{
  position:relative;overflow:hidden;
  margin-bottom:14px;
  border:1px solid rgba(255,255,255,.075);
  border-radius:24px;
  background:
    linear-gradient(135deg,rgba(10,16,25,.96),rgba(6,10,16,.98));
  box-shadow:
    0 28px 80px rgba(0,0,0,.36),
    inset 0 1px 0 rgba(255,255,255,.035);
}
.execArenaBg{
  position:absolute;inset:0;pointer-events:none;opacity:.9;
  background:
    radial-gradient(700px 260px at 50% -10%,rgba(79,142,247,.12),transparent 60%),
    radial-gradient(560px 260px at 10% 100%,rgba(0,208,132,.08),transparent 62%),
    linear-gradient(90deg,transparent 49.8%,rgba(255,255,255,.035) 50%,transparent 50.2%);
}
.executiveArena:before{
  content:"";position:absolute;top:0;left:7%;right:7%;height:3px;
  background:linear-gradient(90deg,transparent,#38bdf8,#8b5cf6,#00d084,transparent);
  filter:drop-shadow(0 0 10px rgba(56,189,248,.35));
}
.execArenaHead{
  position:relative;z-index:2;
  display:flex;align-items:center;justify-content:space-between;gap:18px;
  padding:18px 20px 12px
}
.execKicker{
  font-size:10px;font-weight:950;letter-spacing:.14em;
  color:#7dd3fc
}
.execArenaTitle{
  font-size:25px;font-weight:950;margin-top:3px;
  letter-spacing:-.025em
}
.execArenaSub{
  font-size:10px;color:#7f90a6;line-height:1.8;margin-top:4px
}
.execChampionCallout{
  min-width:330px;
  display:grid;grid-template-columns:42px 1fr auto;gap:10px;align-items:center;
  padding:10px 12px;border-radius:16px;
  border:1px solid rgba(255,176,32,.20);
  background:
    radial-gradient(180px 80px at 90% 0%,rgba(255,176,32,.12),transparent 65%),
    rgba(255,255,255,.025);
}
.execChampionIcon{
  width:42px;height:42px;border-radius:13px;display:grid;place-items:center;
  color:#111;font-size:20px;
  background:linear-gradient(135deg,#ffe17b,#ffad16);
  box-shadow:0 8px 22px rgba(255,176,32,.16)
}
.execChampionCallout span{
  display:block;font-size:7px;color:#a3916a;letter-spacing:.08em
}
.execChampionCallout strong{
  display:block;font-size:13px;margin-top:2px
}
.execChampionCallout>b{
  font-size:24px;color:#ffcf5c;white-space:nowrap
}

.execTrack{
  position:relative;z-index:2;padding:4px 18px 12px
}
.execTrackLine{
  position:absolute;left:4%;right:4%;top:50%;height:1px;
  background:linear-gradient(90deg,transparent,rgba(125,211,252,.18),rgba(255,255,255,.08),rgba(125,211,252,.18),transparent)
}
.execGrid{
  position:relative;
  display:grid;grid-template-columns:repeat(5,minmax(0,1fr));
  gap:10px
}
.execCard{
  --accent:#4f8ef7;
  --status:#4f8ef7;
  position:relative;overflow:hidden;
  min-height:250px;
  padding:14px 14px 12px;
  border-radius:19px;
  border:1px solid color-mix(in srgb,var(--accent) 24%,rgba(255,255,255,.06));
  background:
    radial-gradient(340px 150px at 105% -15%,color-mix(in srgb,var(--accent) 18%,transparent),transparent 62%),
    linear-gradient(155deg,color-mix(in srgb,var(--accent) 7%,#121a26),#0e151f 68%);
  box-shadow:0 16px 34px rgba(0,0,0,.22);
  transform:translateY(var(--lift,0px));
}
.execCard:before{
  content:"";position:absolute;left:0;right:0;top:0;height:4px;
  background:linear-gradient(90deg,transparent,var(--accent),transparent)
}
.execCard:after{
  content:attr(data-rank);
  position:absolute;left:8px;bottom:-22px;
  font-size:92px;font-weight:950;line-height:1;
  color:color-mix(in srgb,var(--accent) 9%,transparent);
  pointer-events:none
}
.execCard.rank1{
  --lift:-8px;
  border-color:rgba(255,176,32,.38);
  box-shadow:0 20px 44px rgba(255,176,32,.06),0 18px 38px rgba(0,0,0,.28)
}
.execTop{
  display:flex;align-items:center;justify-content:space-between;gap:8px
}
.execRank{
  display:flex;align-items:center;gap:7px
}
.execPos{
  width:35px;height:35px;border-radius:11px;display:grid;place-items:center;
  font-size:13px;font-weight:950;
  border:1px solid color-mix(in srgb,var(--accent) 35%,transparent);
  background:color-mix(in srgb,var(--accent) 12%,#111827);
  color:var(--accent)
}
.rank1 .execPos{
  color:#111;border:0;
  background:linear-gradient(135deg,#ffe17b,#ffad16)
}
.execTier{
  font-size:8px;font-weight:900;color:var(--status);
  padding:4px 7px;border-radius:999px;
  background:color-mix(in srgb,var(--status) 8%,#111827);
  border:1px solid color-mix(in srgb,var(--status) 20%,transparent)
}
.execName{
  margin-top:11px;font-size:16px;font-weight:950;line-height:1.4;
  white-space:nowrap;overflow:hidden;text-overflow:ellipsis
}
.execRegions{
  font-size:8px;color:#74859b;margin-top:2px
}
.execGaugeRow{
  display:grid;grid-template-columns:82px 1fr;gap:10px;align-items:center;margin-top:12px
}
.execGauge{
  --p:0;
  width:78px;height:78px;border-radius:50%;
  display:grid;place-items:center;position:relative;
  background:conic-gradient(var(--accent) calc(var(--p)*1%),#1a2638 0)
}
.execGauge:before{
  content:"";position:absolute;inset:7px;border-radius:50%;
  background:#0d141e;border:1px solid rgba(255,255,255,.045)
}
.execGaugeInner{position:relative;z-index:1;text-align:center}
.execGaugeInner b{display:block;font-size:18px;line-height:1;color:var(--accent)}
.execGaugeInner span{display:block;font-size:6px;color:#718198;margin-top:3px}
.execPrimary .label{font-size:7px;color:#75869c}
.execPrimary .value{font-size:24px;font-weight:950;line-height:1;margin-top:3px;color:var(--status)}
.execPrimary .sub{font-size:7px;color:#66778d;margin-top:4px}
.execMiniGrid{
  display:grid;grid-template-columns:repeat(3,1fr);gap:5px;margin-top:11px
}
.execMini{
  padding:7px 5px;text-align:center;border-radius:9px;
  background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.045)
}
.execMini b{display:block;font-size:12px}
.execMini span{display:block;font-size:6px;color:#6f8097;margin-top:2px}
.execCompare{
  margin-top:10px;padding-top:8px;border-top:1px solid rgba(255,255,255,.06);
  display:flex;align-items:center;justify-content:space-between;gap:7px
}
.execCompare span{font-size:7px;color:#73849a}
.execCompare b{font-size:10px}
.execCompare .up{color:#34d399}.execCompare .down{color:#ff7488}.execCompare .flat{color:#fbbf24}

.execArenaFoot{
  position:relative;z-index:2;
  display:grid;grid-template-columns:repeat(4,1fr);gap:1px;
  border-top:1px solid #19263a;background:#19263a
}
.execFootStat{
  background:#0c131d;padding:10px 14px;
  display:flex;align-items:center;justify-content:space-between;gap:8px
}
.execFootStat span{font-size:8px;color:#718198}
.execFootStat b{font-size:11px;color:#dce5ef}

@media(max-width:1250px){
  .execGrid{grid-template-columns:repeat(5,minmax(190px,1fr));overflow-x:auto;padding-bottom:4px}
  .execArenaHead{align-items:flex-start;flex-direction:column}
  .execChampionCallout{min-width:0;width:100%}
}
@media(max-width:900px){
  .execGrid{grid-template-columns:1fr}
  .execCard{min-height:auto;transform:none}
  .execArenaFoot{grid-template-columns:1fr 1fr}
}

.championship{
  border:1px solid #1b293d;border-radius:20px;overflow:hidden;
  background:
    radial-gradient(900px 280px at 50% -12%,rgba(79,142,247,.06),transparent 60%),
    linear-gradient(145deg,#0b1119,#090d13)
}
.champHead{
  padding:15px 18px;border-bottom:1px solid #1b293d;
  display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap
}
.champTitle{font-size:20px;font-weight:950}
.champSub{font-size:11px;color:#7f90a6;margin-top:3px}
.legend{display:flex;gap:9px;flex-wrap:wrap;font-size:10px;color:#8495aa}
.legend i{width:8px;height:8px;border-radius:50%;display:inline-block;margin-left:4px}

.list{
  display:grid;gap:9px;padding:11px
}

.driverCard{
  --accent:#4f8ef7;
  --status:#4f8ef7;
  --newAccent:#38bdf8;
  position:relative;overflow:hidden;
  display:grid;
  grid-template-columns:105px minmax(330px,1.55fr) minmax(200px,.95fr) minmax(185px,.86fr) minmax(185px,.86fr) minmax(185px,.86fr);
  gap:10px;align-items:center;
  min-height:138px;padding:16px 18px;
  border:1px solid rgba(255,255,255,.055);border-radius:16px;
  background:
    radial-gradient(420px 150px at 100% -10%,color-mix(in srgb,var(--accent) 22%,transparent),transparent 58%),
    radial-gradient(380px 120px at -10% 110%,color-mix(in srgb,var(--accent) 12%,transparent),transparent 58%),
    linear-gradient(150deg,
      color-mix(in srgb,var(--accent) 10%,#131b28) 0%,
      color-mix(in srgb,var(--accent) 5%,#101722) 56%,
      #0d141e 100%
    );
  transition:.18s
}
.driverCard:hover{
  transform:translateY(-2px);
  border-color:color-mix(in srgb,var(--accent) 34%,#52627b);
  box-shadow:0 18px 34px rgba(0,0,0,.26),0 0 0 1px color-mix(in srgb,var(--accent) 16%,transparent)
}
.driverCard:before{
  content:"";position:absolute;right:0;top:0;bottom:0;width:5px;background:var(--accent)
}
.driverCard:after{
  content:"";position:absolute;inset:auto auto -34px -34px;width:140px;height:140px;border-radius:50%;
  background:radial-gradient(circle,color-mix(in srgb,var(--accent) 18%,transparent),transparent 68%);
  pointer-events:none;filter:blur(2px)
}
.driverCard.top1{
  border-color:rgba(255,176,32,.42);
  background:
    radial-gradient(600px 150px at 100% -15%,rgba(255,176,32,.18),transparent 60%),
    linear-gradient(150deg,#1a1c20,#11161d)
}
.driverCard.top2{border-color:rgba(184,194,207,.25)}
.driverCard.top3{border-color:rgba(184,115,51,.30)}

.position{
  display:flex;align-items:center;gap:7px
}
.driverCard:not(.top1):not(.top2):not(.top3) .posNum{background:linear-gradient(135deg,color-mix(in srgb,var(--accent) 28%,#1a2435),color-mix(in srgb,var(--accent) 62%,#0f1722));border-color:color-mix(in srgb,var(--accent) 34%,transparent);}
.posNum{
  width:70px;height:70px;border-radius:15px;display:grid;place-items:center;
  background:#182438;border:1px solid #2a3a55;
  font-size:29px;font-weight:950;line-height:1
}
.top1 .posNum{background:linear-gradient(135deg,#ffd45f,#e69300);color:#111;border:0}
.top2 .posNum{background:linear-gradient(135deg,#e3e8ee,#8b98a9);color:#111;border:0}
.top3 .posNum{background:linear-gradient(135deg,#d99d65,#9d5a25);color:#fff;border:0}
.posLabel{font-size:9px;color:#6c7d93;margin-top:3px;text-align:center;font-weight:800}

.identity{min-width:0}
.name{font-size:21px;font-weight:950;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.exec{font-size:12px;color:#8394aa;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.statusLine{display:flex;gap:6px;flex-wrap:wrap;margin-top:8px}
.tag{
  font-size:10px;padding:5px 8px;border-radius:999px;
  background:#172338;border:1px solid #26364e;color:#9eb0c6
}
.tag.status{color:var(--status);border-color:color-mix(in srgb,var(--status) 22%,transparent);background:color-mix(in srgb,var(--status) 8%,#111827)}
.tag.accent{color:var(--accent);border-color:color-mix(in srgb,var(--accent) 24%,transparent);background:color-mix(in srgb,var(--accent) 10%,#111827)}
.tag.newTag{color:var(--newAccent);border-color:color-mix(in srgb,var(--newAccent) 24%,transparent);background:color-mix(in srgb,var(--newAccent) 10%,#111827)}

.metric{
  min-width:0;padding:10px 11px;border-radius:12px;
  background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.045)
}
.metric.mainMetric{
  background:
    linear-gradient(145deg,
      color-mix(in srgb,var(--accent) 10%,#0b1119),
      color-mix(in srgb,var(--accent) 4%,#101721)
    );
  border-color:color-mix(in srgb,var(--accent) 24%,rgba(255,255,255,.04))
}
.metric.ytdMetric:before,
.metric.newMetric:before{
  content:"";display:block;height:3px;border-radius:999px;margin-bottom:9px
}
.metric.ytdMetric:before{background:linear-gradient(90deg,var(--accent),transparent)}
.metric.newMetric{
  background:
    linear-gradient(145deg,
      color-mix(in srgb,var(--newAccent) 10%,#0b1119),
      color-mix(in srgb,var(--newAccent) 4%,#101721)
    );
  border-color:color-mix(in srgb,var(--newAccent) 24%,rgba(255,255,255,.04))
}
.metric.newMetric:before{background:linear-gradient(90deg,var(--newAccent),transparent)}
.metric.newMetric .metricValue{color:var(--newAccent)!important}
.metric.newMetric .metricLabel{color:#8dcdf6}
.metric.ytdMetric .metricLabel{color:#b7f5dc}
.metricLabel{font-size:10px;color:#78899f}
.metricValue{font-size:28px;font-weight:950;line-height:1.05;margin-top:5px}
.metricValue.primary{color:var(--accent)}
.metricSub{font-size:10px;color:#64758b;margin-top:4px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.progress{height:6px;border-radius:999px;background:#182438;overflow:hidden;margin-top:7px}
.progressFill{height:100%;border-radius:999px;background:var(--accent)}
.progressFill.new{background:var(--newAccent)}


.gridHeader{
  display:grid;
  grid-template-columns:105px minmax(330px,1.55fr) minmax(200px,.95fr) minmax(185px,.86fr) minmax(185px,.86fr) minmax(185px,.86fr);
  gap:10px;padding:9px 14px;margin:0 11px 2px;
  color:#6f8198;font-size:10px;font-weight:800
}
.gridHeader div{text-align:center}
.gridHeader div:nth-child(2){text-align:right}

@media(max-width:1300px){
  .hero{grid-template-columns:1.2fr repeat(2,1fr)}
  .heroKpi:nth-child(4),.heroKpi:nth-child(5){display:none}
  .driverCard,.gridHeader{
    grid-template-columns:76px minmax(240px,1.4fr) repeat(4,minmax(135px,.8fr))
  }
}
@media(max-width:900px){
  .header{position:relative;flex-direction:column;align-items:stretch}
  .hero{grid-template-columns:1fr 1fr}
  .heroMain{grid-column:1/-1}
  .controls{grid-template-columns:1fr 1fr}
  .controls input{grid-column:1/-1}
  .gridHeader{display:none}
  .driverCard{
    grid-template-columns:70px minmax(0,1fr) minmax(120px,.7fr);
    gap:8px
  }
  .metric:nth-of-type(n+3){display:none}
  .rankDelta{grid-column:2/-1}
}
</style>
</head>
<body>

<div class="app">
  <header class="header">
    <div class="brand">
      <div class="logo">🏁</div>
      <div style="min-width:0">
        <div class="brandTitle">Daily Market — Regional Championship</div>
        <div class="brandSub">جدول رتبه‌بندی عملکرد توسعه مناطق · سبک Formula 1 Standings</div>
      </div>
    </div>
    <div class="actions">
      <div class="badge live" id="sync">● در حال اتصال...</div>
      <div class="badge" id="updated">آخرین بروزرسانی: —</div>
      <button class="btn" onclick="loadData(true)">↻ بروزرسانی</button>
    </div>
  </header>

  <section class="hero">
    <div class="heroMain">
      <div class="eyebrow">CEO PERFORMANCE SNAPSHOT</div>
      <div class="heroTitle">رتبه‌بندی عملکرد توسعه مناطق</div>
      <div class="heroText">تمام شاخص‌های کلیدی هر منطقه در یک ردیف؛ جایگاه، تحقق کل، عملکرد از شهریور، افتتاح، Gap، قرارداد و فاصله تا رتبه بالاتر.</div>
    </div>
    <div class="heroKpi" style="--c:#00d084">
      <div class="kLabel">تحقق کل هدف تا مهر</div>
      <div class="kVal" id="ytdPct">—</div>
      <div class="kSub" id="ytdSub">—</div>
    </div>
    <div class="heroKpi" style="--c:#4f8ef7">
      <div class="kLabel">تحقق از شهریور</div>
      <div class="kVal" id="newPct">—</div>
      <div class="kSub" id="newSub">—</div>
    </div>
    <div class="heroKpi" style="--c:#ffb020">
      <div class="kLabel">کل افتتاح سال</div>
      <div class="kVal" id="openTotal">—</div>
      <div class="kSub">فروشگاه افتتاح‌شده</div>
    </div>
    <div class="heroKpi" style="--c:#ff4d67">
      <div class="kLabel">مناطق بحرانی</div>
      <div class="kVal" id="criticalCount">—</div>
      <div class="kSub">تحقق کمتر از 40%</div>
    </div>
  </section>

  <section class="controls">
    <input id="search" placeholder="جستجو مدیر منطقه یا مدیر اجرایی..." oninput="applyFilters()">
    <select id="execFilter" onchange="applyFilters()"><option value="">همه مدیران اجرایی</option></select>
    <select id="statusFilter" onchange="applyFilters()">
      <option value="">همه سطوح عملکرد</option>
      <option value="excellent">عالی ≥ 100%</option>
      <option value="good">خوب 70–99%</option>
      <option value="watch">متوسط 40–69%</option>
      <option value="risk">ضعیف &lt; 40%</option>
    </select>
    <select id="sortFilter" onchange="applyFilters()">
      <option value="ytd">رتبه‌بندی بر اساس تحقق کل تا مهر</option>
      <option value="new">رتبه‌بندی بر اساس تحقق از شهریور</option>
      <option value="gap">رتبه‌بندی بر اساس کمترین Gap</option>
      <option value="opened">رتبه‌بندی بر اساس افتتاح</option>
    </select>
    <button onclick="resetFilters()">ریست</button>
    <div class="count" id="count">—</div>
  </section>

  
  <section class="executiveArena">
    <div class="execArenaBg"></div>

    <div class="execArenaHead">
      <div>
        <div class="execKicker">EXECUTIVE COMMAND ARENA</div>
        <div class="execArenaTitle">عملکرد مدیران اجرایی</div>
        <div class="execArenaSub">نمای تجمیعی عملکرد مناطق تحت مدیریت هر مدیر اجرایی؛ رتبه، تحقق کل، عملکرد از شهریور، قرارداد، افتتاح و Gap در یک نمای ویژه.</div>
      </div>

      <div class="execChampionCallout" id="execChampionCallout">
        <div class="execChampionIcon">★</div>
        <div>
          <span>LEADING EXECUTIVE</span>
          <strong id="execChampionName">—</strong>
        </div>
        <b id="execChampionScore">—</b>
      </div>
    </div>

    <div class="execTrack">
      <div class="execTrackLine"></div>
      <div class="execGrid" id="execGrid"></div>
    </div>

    <div class="execArenaFoot">
      <div class="execFootStat">
        <span>بیشترین تحقق کل</span>
        <b id="execBestYtd">—</b>
      </div>
      <div class="execFootStat">
        <span>بهترین عملکرد از شهریور</span>
        <b id="execBestNew">—</b>
      </div>
      <div class="execFootStat">
        <span>بیشترین افتتاح</span>
        <b id="execBestOpen">—</b>
      </div>
      <div class="execFootStat">
        <span>کمترین Gap</span>
        <b id="execBestGap">—</b>
      </div>
    </div>
  </section>

<section class="championship">
    <div class="champHead">
      <div>
        <div class="champTitle">Regional Standings — رتبه ۱ تا ۲۴</div>
        <div class="champSub">نمای خطی شبیه جدول Formula 1؛ هرچه از صدر جدول پایین‌تر می‌رویم، رنگ کارت‌ها هم وخامت عملکرد را بیشتر القا می‌کند و شاخص‌های کلیدی در دو ستون متمایز نمایش داده می‌شوند.</div>
      </div>
      <div class="legend">
        <span><i style="background:#00d084"></i>عالی</span>
        <span><i style="background:#4f8ef7"></i>خوب</span>
        <span><i style="background:#ffb020"></i>متوسط</span>
        <span><i style="background:#ff4d67"></i>ضعیف</span>
      </div>
    </div>

    <div class="gridHeader">
      <div>رتبه</div>
      <div>مدیر منطقه / مدیر اجرایی</div>
      <div>تحقق کل تا مهر</div>
      <div>تحقق از شهریور</div>
      <div>افتتاح / قرارداد</div>
      <div>Gap / Pipeline</div>
      
    </div>

    <div class="list" id="list"></div>
  </section>
</div>

<script>
const API_URL="https://script.google.com/macros/s/AKfycbxR0BMOAjbgVuYqaxJxQPBtIPYC_K7IxgMA2PaLrE5KREqSqEDvjWUqryIVNwob6cnm/exec";

let ALL=[],DATA=[];

const n=v=>{const x=parseFloat(String(v??'').replace(/[,٪%]/g,''));return Number.isFinite(x)?x:0};
const pct=v=>{let x=n(v);if(Math.abs(x)<=3)x*=100;return x};
const sum=(a,k)=>a.reduce((s,d)=>s+(+d[k]||0),0);
const fmt=x=>(Math.round(x*10)/10).toLocaleString('fa-IR');

function norm(s){
  return String(s??'').replace(/ي/g,'ی').replace(/ك/g,'ک')
    .replace(/[\u200c\u200f\u202a-\u202e]/g,' ')
    .replace(/[٪%:()\-_/\\]/g,' ').replace(/\s+/g,' ').trim().toLowerCase();
}
function color(p){return p>=100?'#00d084':p>=70?'#4f8ef7':p>=40?'#ffb020':'#ff4d67'}
function label(p){return p>=100?'عالی':p>=70?'خوب':p>=40?'متوسط':'ضعیف'}
function statusClass(p){return p>=100?'excellent':p>=70?'good':p>=40?'watch':'risk'}

function accentByRank(rank,total){
  if(total<=1) return 'hsl(145 80% 46%)';
  const t=(rank-1)/(total-1); // 0 top -> 1 bottom
  const hue=145-(145*t);      // green -> red
  const sat=82;
  const light=50-(t*4);
  return `hsl(${hue} ${sat}% ${light}%)`;
}


function mapData(objects){
  return objects.map(obj=>{
    const m={};Object.entries(obj||{}).forEach(([k,v])=>m[norm(k)]=v);
    const get=A=>{
      const a=A.map(norm);
      for(const x of a)if(x in m)return m[x];
      for(const x of a){const k=Object.keys(m).find(k=>k.includes(x)||x.includes(k));if(k)return m[k]}
      return"";
    };
    const name=String(get(['مدیر منطقه'])||'').trim();if(!name)return null;
    const exec=String(get(['مدیر اجرایی'])||'').trim()||'تعیین نشده';
    const newTarget=n(get(['هدف جدید از شهریور تا مهر']));
    const newHQ=n(get(['قرارداد ستادی از شهریور','قرارداد ستادی']));
    const newFran=n(get(['ترهین فرانچایز از شهریور','ترهین فرانچایز','قرارداد فرانچایز از شهریور','قرارداد فرانچایز']));
    const newContracts=n(get(['کل قرارداد از شهریور']))||(newHQ+newFran);
    const pipeline=n(get(['درحال افتتاح','در حال افتتاح']));
    const totalHQ=n(get(['مجموع قرارداد ستادی']));
    const totalFran=n(get(['مجموع قرارداد فرانچایز']));
    const totalContracts=n(get(['مجموع کل قرارداد','مجموع قرارداد']));
    const totalOpened=n(get(['مجموع افتتاح']));
    const ytdTarget=n(get(['هدف تا مهر ماه','هدف تا مهر']));

    let newPct=pct(get(['تحقق هدف جدید قراردادی از شهریور','تحقق هدف قراردادی از شهریور','تحقق هدف جدید قراردادی']));
    if(!newPct&&newTarget)newPct=newContracts/newTarget*100;

    let ytdPct=pct(get(['تحقق هدف قراردادی تا مهر','تحقق کل هدف قراردادی تا مهر']));
    if(!ytdPct&&ytdTarget)ytdPct=totalContracts/ytdTarget*100;

    const gap=Math.max(ytdTarget-totalContracts,0);
    return{name,exec,newTarget,newHQ,newFran,newContracts,pipeline,totalHQ,totalFran,totalContracts,totalOpened,ytdTarget,newPct,ytdPct,gap};
  }).filter(Boolean);
}

async function loadData(manual=false){
  const sync=document.getElementById('sync');
  sync.textContent=manual?'● در حال بروزرسانی...':'● در حال اتصال...';
  sync.style.color='#ffcf66';
  try{
    const r=await fetch(API_URL+'?t='+Date.now(),{cache:'no-store',redirect:'follow'});
    if(!r.ok)throw new Error('HTTP '+r.status);
    const p=await r.json();
    if(!p?.success||!Array.isArray(p.data))throw new Error('Invalid payload');
    ALL=mapData(p.data);
    populateExec();
    applyFilters();
    sync.textContent='● اتصال زنده';
    sync.style.color='#38e8a0';
    document.getElementById('updated').textContent='آخرین بروزرسانی: '+new Date().toLocaleTimeString('fa-IR',{hour:'2-digit',minute:'2-digit'});
  }catch(e){
    console.error(e);
    sync.textContent='● خطای اتصال';
    sync.style.color='#ff7488';
  }
}

function populateExec(){
  const s=document.getElementById('execFilter'),cur=s.value;
  const ex=[...new Set(ALL.map(d=>d.exec))].sort((a,b)=>a.localeCompare(b,'fa'));
  s.innerHTML='<option value="">همه مدیران اجرایی</option>'+ex.map(x=>`<option value="${x}">${x}</option>`).join('');
  if(ex.includes(cur))s.value=cur;
}

function resetFilters(){
  search.value='';execFilter.value='';statusFilter.value='';sortFilter.value='ytd';
  applyFilters();
}

function applyFilters(){
  const q=search.value.trim().toLowerCase(),ex=execFilter.value,st=statusFilter.value,sort=sortFilter.value;
  DATA=ALL.filter(d=>(!q||(d.name+' '+d.exec).toLowerCase().includes(q))&&(!ex||d.exec===ex)&&(!st||statusClass(d.ytdPct)===st));

  if(sort==='ytd')DATA.sort((a,b)=>b.ytdPct-a.ytdPct||b.newPct-a.newPct);
  if(sort==='new')DATA.sort((a,b)=>b.newPct-a.newPct||b.ytdPct-a.ytdPct);
  if(sort==='gap')DATA.sort((a,b)=>a.gap-b.gap||b.ytdPct-a.ytdPct);
  if(sort==='opened')DATA.sort((a,b)=>b.totalOpened-a.totalOpened||b.ytdPct-a.ytdPct);

  count.textContent=DATA.length.toLocaleString('fa-IR')+' منطقه';
  render();
}


function buildExecutiveData(source){
  const groups={};
  source.forEach(d=>{
    if(!groups[d.exec]){
      groups[d.exec]={
        name:d.exec,regions:0,
        ytdTarget:0,totalContracts:0,
        newTarget:0,newContracts:0,
        totalOpened:0,pipeline:0,
        totalHQ:0,totalFran:0,gap:0
      };
    }
    const g=groups[d.exec];
    g.regions++;
    g.ytdTarget+=d.ytdTarget;
    g.totalContracts+=d.totalContracts;
    g.newTarget+=d.newTarget;
    g.newContracts+=d.newContracts;
    g.totalOpened+=d.totalOpened;
    g.pipeline+=d.pipeline;
    g.totalHQ+=d.totalHQ;
    g.totalFran+=d.totalFran;
  });

  return Object.values(groups).map(g=>{
    g.ytdPct=g.ytdTarget?g.totalContracts/g.ytdTarget*100:0;
    g.newPct=g.newTarget?g.newContracts/g.newTarget*100:0;
    g.gap=Math.max(g.ytdTarget-g.totalContracts,0);
    g.momentum=g.newPct-g.ytdPct;
    return g;
  }).sort((a,b)=>b.ytdPct-a.ytdPct||b.newPct-a.newPct);
}

function renderExecutives(){
  const execs=buildExecutiveData(ALL);
  if(!execs.length) return;

  const total=execs.length;
  const avg=execs.reduce((s,d)=>s+d.ytdPct,0)/total;

  document.getElementById('execGrid').innerHTML=execs.map((d,i)=>{
    const rank=i+1;
    const accent=accentByRank(rank,total);
    const s=color(d.ytdPct);
    const momentum=d.momentum;
    const momentumClass=momentum>5?'up':momentum<-5?'down':'flat';
    const momentumText=momentum>5?'▲ شتاب مثبت':momentum<-5?'▼ افت شتاب':'● پایدار';
    const vsAvg=d.ytdPct-avg;
    const vsText=(vsAvg>0?'+':'')+fmt(vsAvg)+'pp';

    return `
      <article class="execCard ${rank===1?'rank1':''}" data-rank="0${rank}" style="--accent:${accent};--status:${s}">
        <div class="execTop">
          <div class="execRank">
            <div class="execPos">${rank.toLocaleString('fa-IR')}</div>
            <div class="execTier">${label(d.ytdPct)}</div>
          </div>
          <div style="font-size:8px;color:${momentum>=0?'#34d399':'#ff7488'}">${momentumText}</div>
        </div>

        <div class="execName">${d.name}</div>
        <div class="execRegions">${d.regions.toLocaleString('fa-IR')} منطقه تحت مدیریت</div>

        <div class="execGaugeRow">
          <div class="execGauge" style="--p:${Math.min(d.ytdPct,100)}">
            <div class="execGaugeInner">
              <b>${fmt(d.ytdPct)}%</b>
              <span>تا مهر</span>
            </div>
          </div>

          <div class="execPrimary">
            <div class="label">تحقق از شهریور</div>
            <div class="value">${fmt(d.newPct)}%</div>
            <div class="sub">${d.newContracts.toLocaleString('fa-IR')} / ${d.newTarget.toLocaleString('fa-IR')} قرارداد</div>
          </div>
        </div>

        <div class="execMiniGrid">
          <div class="execMini">
            <b>${d.totalContracts.toLocaleString('fa-IR')}</b>
            <span>کل قرارداد</span>
          </div>
          <div class="execMini">
            <b>${d.totalOpened.toLocaleString('fa-IR')}</b>
            <span>افتتاح</span>
          </div>
          <div class="execMini">
            <b>${d.gap.toLocaleString('fa-IR')}</b>
            <span>Gap</span>
          </div>
        </div>

        <div class="execCompare">
          <span>نسبت به میانگین مدیران اجرایی</span>
          <b class="${vsAvg>3?'up':vsAvg<-3?'down':'flat'}">${vsText}</b>
        </div>
      </article>`;
  }).join('');

  const bestYtd=[...execs].sort((a,b)=>b.ytdPct-a.ytdPct)[0];
  const bestNew=[...execs].sort((a,b)=>b.newPct-a.newPct)[0];
  const bestOpen=[...execs].sort((a,b)=>b.totalOpened-a.totalOpened)[0];
  const bestGap=[...execs].sort((a,b)=>a.gap-b.gap)[0];

  document.getElementById('execChampionName').textContent=bestYtd.name;
  document.getElementById('execChampionScore').textContent=fmt(bestYtd.ytdPct)+'%';

  document.getElementById('execBestYtd').textContent=`${bestYtd.name} · ${fmt(bestYtd.ytdPct)}%`;
  document.getElementById('execBestNew').textContent=`${bestNew.name} · ${fmt(bestNew.newPct)}%`;
  document.getElementById('execBestOpen').textContent=`${bestOpen.name} · ${bestOpen.totalOpened.toLocaleString('fa-IR')}`;
  document.getElementById('execBestGap').textContent=`${bestGap.name} · ${bestGap.gap.toLocaleString('fa-IR')}`;
}

function render(){
  renderExecutives();
  const ytdTarget=sum(DATA,'ytdTarget'),totalContracts=sum(DATA,'totalContracts');
  const newTarget=sum(DATA,'newTarget'),newContracts=sum(DATA,'newContracts');
  const ytd=ytdTarget?totalContracts/ytdTarget*100:0;
  const np=newTarget?newContracts/newTarget*100:0;

  ytdPct.textContent=fmt(ytd)+'%';
  ytdSub.textContent=`${totalContracts.toLocaleString('fa-IR')} قرارداد از هدف ${ytdTarget.toLocaleString('fa-IR')}`;
  newPct.textContent=fmt(np)+'%';
  newSub.textContent=`${newContracts.toLocaleString('fa-IR')} قرارداد از هدف ${newTarget.toLocaleString('fa-IR')}`;
  openTotal.textContent=sum(DATA,'totalOpened').toLocaleString('fa-IR');
  criticalCount.textContent=DATA.filter(d=>d.ytdPct<40).length.toLocaleString('fa-IR');

  const ranked=[...DATA];
  list.innerHTML=ranked.map((d,i)=>{
    const rank=i+1;
    const s=color(d.ytdPct);
    const accent=accentByRank(rank,ranked.length);

    return `
      <article class="driverCard ${rank===1?'top1':rank===2?'top2':rank===3?'top3':''}" style="--status:${s};--accent:${accent};--newAccent:#38bdf8">
        <div class="position">
          <div>
            <div class="posNum">${rank.toLocaleString('fa-IR')}</div>
            <div class="posLabel">POSITION</div>
          </div>
        </div>

        <div class="identity">
          <div class="name">${d.name}</div>
          <div class="exec">مدیر اجرایی: ${d.exec}</div>
          <div class="statusLine">
            <span class="tag status">${label(d.ytdPct)}</span>
            <span class="tag accent">رتبه عملکرد</span>
            <span class="tag newTag">شاخص شهریور</span>
            <span class="tag">کل قرارداد ${d.totalContracts.toLocaleString('fa-IR')}</span>
            <span class="tag">ستادی ${d.totalHQ.toLocaleString('fa-IR')}</span>
            <span class="tag">فرانچایز ${d.totalFran.toLocaleString('fa-IR')}</span>
          </div>
        </div>

        <div class="metric mainMetric ytdMetric">
          <div class="metricLabel">تحقق هدف تا مهر</div>
          <div class="metricValue primary">${fmt(d.ytdPct)}%</div>
          <div class="metricSub">${d.totalContracts.toLocaleString('fa-IR')} / ${d.ytdTarget.toLocaleString('fa-IR')} قرارداد</div>
          <div class="progress"><div class="progressFill" style="width:${Math.min(d.ytdPct,100)}%"></div></div>
        </div>

        <div class="metric newMetric">
          <div class="metricLabel">تحقق هدف از شهریور</div>
          <div class="metricValue">${fmt(d.newPct)}%</div>
          <div class="metricSub">${d.newContracts.toLocaleString('fa-IR')} / ${d.newTarget.toLocaleString('fa-IR')} قرارداد</div>
          <div class="progress"><div class="progressFill new" style="width:${Math.min(d.newPct,100)}%"></div></div>
        </div>

        <div class="metric">
          <div class="metricLabel">افتتاح</div>
          <div class="metricValue">${d.totalOpened.toLocaleString('fa-IR')}</div>
          <div class="metricSub">Pipeline: ${d.pipeline.toLocaleString('fa-IR')}</div>
        </div>

        <div class="metric">
          <div class="metricLabel">Gap تا مهر</div>
          <div class="metricValue" style="color:${d.gap===0?'#34d399':'#ffb020'}">${d.gap.toLocaleString('fa-IR')}</div>
          <div class="metricSub">فاصله عددی تا هدف</div>
        </div>
      </article>`;
  }).join('');
}

loadData();
setInterval(()=>loadData(false),5*60*1000);
</script>
</body>
</html>
